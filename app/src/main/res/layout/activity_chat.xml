<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:animateLayoutChanges="true"
    android:fitsSystemWindows="true"
    tools:context=".activities.ChatActivity"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/profileHeader">

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/icon_back"
            android:backgroundTint="@color/primary"
            android:background="@drawable/background_image"
            android:scaleType="centerCrop"
            app:riv_oval="true"/>
        <TextView
            android:id="@+id/userName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:layout_marginStart="5dp"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:layout_weight="1"/>
        <ImageView
            android:contentDescription="@string/user_information"
            android:id="@+id/signOut"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/icon_info"
            android:padding="5dp"
            android:background="@drawable/background_image"
            android:backgroundTint="@color/primary"
            android:scaleType="centerCrop"
            app:riv_oval="true"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/view_background_design"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="90dp"
        app:layout_constraintTop_toBottomOf="@id/profileHeader"
        android:background="@drawable/scrollview_rounded">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:clipToPadding="false"
            android:visibility="gone"
            app:stackFromEnd="true"
            android:padding="5dp"
            android:layout_marginBottom="90dp"/>

        <ProgressBar
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:id="@+id/progressionBar"
            android:progressBackgroundTint="@color/primary"
            android:backgroundTint="@color/primary"
            android:layout_marginBottom="15dp"/>

    </FrameLayout>


    <ImageView
        android:contentDescription="@string/send_message"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/buttonSend"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/icon_send"
        android:background="@drawable/background_image"
        android:backgroundTint="@color/primary"
        android:scaleType="centerCrop"
        app:riv_oval="true"/>

    <EditText
        android:hint="@string/type_a_message"
        android:textColorHint="@color/white"
        android:background="@drawable/background_chat_input"
        android:id="@+id/inputMessage"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonSend"
        android:layout_marginBottom="20dp"
        android:textColor="@color/white"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="5dp"
        android:inputType="text"
        android:importantForAutofill="no"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        />



</androidx.constraintlayout.widget.ConstraintLayout>